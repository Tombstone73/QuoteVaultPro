# Database Configuration
# Get a free PostgreSQL database from Neon: https://neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional: use a direct/non-pooled database URL only for startup migrations.
# App runtime continues to use DATABASE_URL.
MIGRATION_DATABASE_URL=
DIRECT_DATABASE_URL=
# Optional migration lock tuning. Defaults: 30000ms dev/test, 120000ms production.
MIGRATION_LOCK_TIMEOUT_MS=
MIGRATION_LOCK_RETRY_MS=

# Session Secret (generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# Dedicated DEV-only Playwright QA identity. Define values only in ignored local
# test configuration or a CI secret store; never put credential values in Git.
PRINTERSHERO_DEV_QA_EMAIL=
PRINTERSHERO_DEV_QA_PASSWORD=
PRINTERSHERO_DEV_QA_ALLOWED_ORIGIN=
PRINTERSHERO_DEV_QA_EXPECTED_ORG_ID=
PRINTERSHERO_DEV_QA_EXPECTED_ORG_SLUG=
# Temporary, one-time Railway DEV command guard. Remove after provisioning.
PRINTERSHERO_DEV_QA_PROVISION_ENABLED=

# Node Environment
NODE_ENV=development

# Frontend API Base URL (optional override)
# Leave unset for normal same-origin browser routing.
# Set this only when the deployed frontend intentionally talks to a separate API host.
# Example: VITE_API_BASE_URL=https://dev.printershero.com
VITE_API_BASE_URL=

# Public web research fallback (optional). This is not needed when the active
# provider/model exposes native web search (for example DeepSeek V4-Flash
# Responses); do not expose this value to the browser.
# PUBLIC_WEB_SEARCH_API_KEY=
# Optional bounded provider timeout for AI Operator decisions (default: 120000 ms).
# AI_OPERATOR_PROVIDER_TIMEOUT_MS=120000
# Optional bounded number of Operator decisions per request (default: 16; hard max: 24).
# This includes native-web continuations and PrintersHero function-tool decisions.
# AI_OPERATOR_MAX_STEPS=16
# Optional DeepSeek Responses output budget for Operator reports (default: 8192; hard max: 16384).
# This is deliberately separate from the generic structured-JSON token limit.
# AI_OPERATOR_MAX_OUTPUT_TOKENS=8192
# Optional Brave-compatible endpoint override. Keep the default unless using
# an approved server-side search provider.
# PUBLIC_WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# ===== BACKGROUND WORKERS CONFIGURATION =====
# Control background workers to prevent Neon compute burn in dev/preview environments
# 
# Global kill switch (overrides all per-worker settings):
# WORKERS_ENABLED=false    # Disables ALL workers regardless of per-worker flags
# WORKERS_ENABLED=true     # Allows per-worker flags to work (default in production)
#
# QuickBooks has two historical autonomous worker paths. Select exactly one
# deployment owner; the V2 invoice/payment derived queue is the cutover default.
# QUICKBOOKS_AUTOMATION_OWNER=queue        # QB_QUEUE active; QB_SYNC disabled
# QUICKBOOKS_AUTOMATION_OWNER=legacy_jobs  # temporary migration only; QB_SYNC active; QB_QUEUE disabled
#
# Default behavior (when WORKERS_ENABLED is not set):
# - Production: Workers default to ENABLED unless explicitly disabled
# - Non-production (dev/preview): Workers default to DISABLED unless explicitly enabled
#
# Per-worker enable/disable:
# WORKER_THUMBNAILS_ENABLED=true       # Enable thumbnail generation worker
# WORKER_ASSET_PREVIEW_ENABLED=true    # Enable asset preview worker
# WORKER_QB_SYNC_ENABLED=true          # Enable QuickBooks sync job processor
# WORKER_QB_QUEUE_ENABLED=true         # Enable QuickBooks invoice/payment queue worker
# WORKER_UPLOAD_CLEANUP_ENABLED=true   # Enable chunked upload temp cleanup
#
# Product-specific enable/disable aliases:
# THUMBNAIL_WORKER_ENABLED=true
# ASSET_PREVIEW_WORKER_ENABLED=true
# QUICKBOOKS_WORKER_ENABLED=true       # Gates the selected QB worker; it cannot select both
# UPLOAD_CLEANUP_WORKER_ENABLED=true
#
# Per-worker interval overrides (milliseconds):
# WORKER_THUMBNAILS_INTERVAL_MS=21600000      # Thumbnail fallback sweep (default: 6h)
# WORKER_ASSET_PREVIEW_INTERVAL_MS=21600000   # Asset preview fallback sweep (default: 6h)
# WORKER_QB_SYNC_INTERVAL_MS=3600000          # QB sync job processor interval (default: 60min prod)
# WORKER_QB_QUEUE_INTERVAL_MS=3600000         # QB queue worker interval (default: 60min prod)
# WORKER_UPLOAD_CLEANUP_INTERVAL_MS=21600000  # Chunked upload cleanup interval (default: 6h)
#
# Product-specific interval aliases:
# THUMBNAIL_WORKER_FALLBACK_INTERVAL_MS=21600000
# ASSET_PREVIEW_WORKER_FALLBACK_INTERVAL_MS=21600000
# QUICKBOOKS_SYNC_INTERVAL_MS=3600000
# QUICKBOOKS_SYNC_STABILITY_WINDOW_MS=1800000
# UPLOAD_CLEANUP_WORKER_INTERVAL_MS=21600000
#
# Legacy env vars (still supported for backwards compatibility):
# THUMBNAIL_WORKER_POLL_INTERVAL_MS=10000
# QB_SYNC_QUEUE_INTERVAL_MS=300000
#
# Example: Enable only thumbnails worker in development with 1min polling:
# WORKER_THUMBNAILS_ENABLED=true
# WORKER_THUMBNAILS_INTERVAL_MS=60000

# Optional: Replit OIDC (only needed if using Replit authentication)
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com

# QuickBooks Integration (optional)
# Get credentials from: https://developer.intuit.com
# QUICKBOOKS_CLIENT_ID=your-client-id
# QUICKBOOKS_CLIENT_SECRET=your-client-secret
# QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/integrations/quickbooks/callback
# QUICKBOOKS_ENVIRONMENT=sandbox # or 'production'

# Stripe Payments v1
# STRIPE_SECRET_KEY: Stripe Dashboard → Developers → API keys (secret key)
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: Stripe CLI `stripe listen` output (whsec_...) or Dashboard endpoint secret
STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY: Stripe Dashboard → Developers → API keys (publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=
