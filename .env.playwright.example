# Playwright E2E environment variables
# Copy this file to .env.playwright and fill in the values.
# .env.playwright is gitignored — never commit real credentials.
# Required variables: PLAYWRIGHT_BASE_URL, PLAYWRIGHT_EMAIL, PLAYWRIGHT_PASSWORD.
# Everything below that point is optional per-spec fixture data.

# Base URL of the target environment (no trailing slash).
# For the deployed DEV instance, use the full https:// URL.
PLAYWRIGHT_BASE_URL=https://dev.printershero.com

# Dedicated DEV-only browser QA identity. Values belong only in ignored local
# configuration or the CI secret store; never commit real credentials.
PRINTERSHERO_DEV_QA_EMAIL=
PRINTERSHERO_DEV_QA_PASSWORD=

# The base URL must exactly equal this approved DEV origin. The fixture rejects
# PrintersHero production hosts before it submits any credentials.
PRINTERSHERO_DEV_QA_ALLOWED_ORIGIN=https://dev.printershero.com

# The QA user must have exactly one membership in this DEV organization.
PRINTERSHERO_DEV_QA_EXPECTED_ORG_ID=
PRINTERSHERO_DEV_QA_EXPECTED_ORG_SLUG=

# Compatibility aliases for older specs. Leave unset: playwright.config.ts maps
# these from the dedicated QA variables for each run.
# PLAYWRIGHT_EMAIL=
# PLAYWRIGHT_PASSWORD=

# Disposable DEV quote id for the quote → order conversion smoke test.
# This quote must exist, be accessible to the test user, have at least one line item,
# and NOT already be converted. The test mutates this quote by creating an order.
PLAYWRIGHT_QUOTE_TO_ORDER_QUOTE_ID=

# Optional: keep the browser open briefly after the created order page loads.
# Useful while stabilizing headed smoke tests against deployed DEV.
# Example: 5000 keeps the page visible for 5 seconds before continuing.
PLAYWRIGHT_DEBUG_HOLD_MS=

# An order number that is currently sitting in the Prepress queue.
# The order must have requiresPrepress=true and an active production job
# with stepKey='prepress' (i.e., not yet sent to the flatbed print board).
# If this is unset, the prepress queue visibility test will be skipped (not failed).
PLAYWRIGHT_TEST_ORDER_NUMBER=

# Dedicated DEV order number for the prepress → production handoff smoke test.
# This order must already be visible in Prepress, be actively owned by prepress,
# be in prepress_complete state, have at least one visible final file,
# and have NO active downstream production job yet.
PLAYWRIGHT_PREPRESS_TO_PRODUCTION_ORDER_NUMBER=

# An order number used for the Prepress → Roll ROUTING transition test.
# This order must meet ALL of the following before running:
#   - Has requiresPrepress=true on the line item
#   - Has an active prepress production job (stationKey='flatbed', stepKey='prepress')
#   - Has a COMPLETED prepress session (prepressStage='prepress_complete')
#   - Has at least one active "final" file uploaded to the line item
#   - Has NO active downstream production job
#   - Has a product type with defaultStationKey='roll' OR a name containing "roll"
# If this is unset, the routing transition test will be skipped (not failed).
# WARNING: Running this test MUTATES the order — it routes it to the Roll board.
# Use only disposable DEV data.
PLAYWRIGHT_ROUTING_TEST_ORDER_NUMBER=

# Optional: specific open shipping/delivery order for the fulfillment ship flow.
# If unset, the fulfillment validation spec will auto-discover a recent open ship-eligible order.
PLAYWRIGHT_FULFILLMENT_SHIP_ORDER_NUMBER=

# Optional: specific open pickup order for the fulfillment pickup flow.
# If unset, the fulfillment validation spec will auto-discover a recent open pickup order.
PLAYWRIGHT_FULFILLMENT_PICKUP_ORDER_NUMBER=

# production-jobs-regression.spec.ts
# No additional env vars required — the spec seeds its own disposable fixture
# using db directly (same pattern as proofing-dev-regression.spec.ts).
# Prerequisites: PLAYWRIGHT_BASE_URL, PLAYWRIGHT_EMAIL, PLAYWRIGHT_PASSWORD (required above).
