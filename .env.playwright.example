# Playwright E2E environment variables
# Copy this file to .env.playwright and fill in the values.
# .env.playwright is gitignored — never commit real credentials.

# Base URL of the target environment (no trailing slash).
# For the deployed DEV instance, use the full https:// URL.
PLAYWRIGHT_BASE_URL=https://your-dev-instance.example.com

# Login credentials for a test user that has at least Manager-level access.
PLAYWRIGHT_EMAIL=testuser@example.com
PLAYWRIGHT_PASSWORD=your-test-password

# An order number that is currently sitting in the Prepress queue.
# The order must have requiresPrepress=true and an active production job
# with stepKey='prepress' (i.e., not yet sent to the flatbed print board).
# If this is unset, the prepress queue test will be skipped (not failed).
PLAYWRIGHT_TEST_ORDER_NUMBER=
