{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://printershero-dev-development.up.railway.app/api/:path*"
    },
    {
      "source": "/objects/:path*",
      "destination": "https://printershero-dev-development.up.railway.app/objects/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
