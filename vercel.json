{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-dev.printershero.com/api/:path*"
    },
    {
      "source": "/objects/:path*",
      "destination": "https://api-dev.printershero.com/objects/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}