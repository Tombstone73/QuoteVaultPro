{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/typescript/v2.tsbuildinfo",
    "noEmit": true,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "infrastructure/**/*.ts", "types/**/*.d.ts"]
}
